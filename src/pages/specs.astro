---
// Hallmark · macrostructure: Statement Page · tone: technical-brutal (washi / sumi ink / vermilion) · theme: inherited from tailwind.config.mjs (preserved)
// Specification book placeholder — V3-BETA is under review, contents pending release
import Layout from '../layouts/Layout.astro';

const planned = [
  { icon: 'straighten', item: 'Volumetric envelopes & scaling rules' },
  { icon: 'architecture', item: 'Arena tolerances & surface fidelity' },
  { icon: 'scale', item: 'Weight classes & dimension limits' },
  { icon: 'checklist', item: 'Pre-match homologation protocols' },
];
---

<Layout title="SPECIFICATION BOOK // COMING SOON [IEEE ROBOKO]">
  <header class="border-b-2 border-surface-variant bg-surface">
    <div class="w-full max-w-7xl mx-auto px-margin h-16 flex items-center justify-between gap-space-md">
      <a
        class="text-headline-sm font-headline-sm font-bold uppercase tracking-widest text-on-surface flex items-center gap-2 whitespace-nowrap"
        href="/"
      >
        <span class="bg-primary-container text-accent-ink px-2 py-1 text-label-stamp font-label-stamp border border-surface-variant">IEEE</span>
        <span class="tracking-tighter normal-case">Roboko</span>
      </a>
      <a
        class="whitespace-nowrap text-label-stamp font-label-stamp text-tertiary uppercase tracking-wider hover:text-primary-container transition-none flex items-center gap-1"
        href="/"
      >
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span>RETURN TO ARENA</span>
      </a>
    </div>
  </header>

  <main class="grid-blueprint bg-surface-container-lowest border-b-2 border-surface-variant">
    <section class="w-full max-w-7xl mx-auto px-margin py-space-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-space-sm mb-space-md">
            <span class="text-label-badge font-label-badge text-primary-container bg-surface-container-high border border-primary-container px-2 py-0.5 uppercase">
              [ COMPLIANCE_DOCUMENTATION ]
            </span>
            <span class="text-label-badge font-label-badge text-tertiary uppercase tracking-widest">RELEASE 3.0-BETA // PENDING</span>
          </div>
          <h1 class="text-headline-xl-mobile md:text-headline-xl font-headline-xl uppercase text-on-surface tracking-tighter leading-none mb-space-md overflow-wrap-anywhere">
            SPEC BOOK<br />
            <span class="text-primary-container">COMING SOON.</span>
          </h1>
          <p class="text-body-lg font-body-lg text-tertiary max-w-2xl mb-space-md">
            The V3-BETA specification manual is under review by the technical committee. Its verified contents will be
            published here once cleared for release.
          </p>
          <p class="text-body-md font-body-md text-tertiary max-w-2xl mb-space-xl">
            Until then, the arena tolerances summary on the main page and the scrutineering protocols remain the
            authoritative reference for competitors.
          </p>
          <div class="flex flex-wrap items-center gap-space-md">
            <a
              class="btn-brutal whitespace-nowrap bg-primary-container text-accent-ink font-headline-sm text-headline-sm px-space-xl py-space-md border-2 border-on-surface uppercase shadow-hard-red flex items-center gap-space-sm hover:bg-on-primary-container hover:text-accent-ink transition-none"
              href="https://docs.google.com/forms/d/e/1FAIpQLSdIt04-N2yoR09JSIVkVqnmnrvGI9x5hgCHkITfQ432N1-A_g/viewform?usp=dialog"
              target="_blank" rel="noopener noreferrer"
            >
              <span class="material-symbols-outlined" aria-hidden="true">swords</span>
              <span>REGISTER SQUAD</span>
            </a>
            <a
              class="btn-brutal whitespace-nowrap bg-surface-container-high text-on-surface font-headline-sm text-headline-sm px-space-lg py-space-md border-2 border-surface-variant uppercase shadow-hard-black hover:border-on-surface flex items-center gap-space-sm transition-none"
              href="/#arena-specs"
            >
              <span class="material-symbols-outlined" aria-hidden="true">description</span>
              <span>ARENA SPECS SUMMARY</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-surface-container border-2 border-primary-container p-space-md shadow-hard-red">
            <div class="flex items-center justify-between border-b-2 border-surface-variant pb-space-sm mb-space-sm">
              <span class="text-label-stamp font-label-stamp text-on-surface uppercase tracking-wider">PLANNED CONTENTS // 目次</span>
              <span class="text-label-badge font-label-badge text-secondary-container">STATUS: IN REVIEW</span>
            </div>
            {planned.map((row) => (
              <div class="flex items-center justify-between gap-2 border-b border-surface-variant py-space-sm last:border-b-0">
                <span class="flex items-center gap-2 min-w-0">
                  <span class="material-symbols-outlined text-primary-container shrink-0" aria-hidden="true">{row.icon}</span>
                  <span class="text-body-sm font-body-sm text-on-surface font-bold overflow-wrap-anywhere">{row.item}</span>
                </span>
                <span class="text-label-badge font-label-badge text-secondary-container shrink-0">—</span>
              </div>
            ))}
            <div class="mt-space-sm pt-2 border-t-2 border-surface-variant flex items-center justify-between text-label-badge font-label-badge">
              <span class="text-tertiary">CONTENT MAY CHANGE BEFORE FINAL RELEASE</span>
              <span class="text-primary-container font-bold">V3-BETA</span>
            </div>
          </div>

          <div class="hidden lg:flex mt-space-md bg-surface-dim border-2 border-surface-variant p-space-md items-center gap-space-md shadow-hard-black">
            <span class="w-2.5 h-2.5 bg-secondary-container shrink-0" aria-hidden="true"></span>
            <p class="text-label-stamp font-label-stamp text-secondary-container uppercase tracking-wider">
              Publish flag currently set to <span class="text-on-surface">UNDER_REVIEW</span> // will flip to <span class="text-on-surface">RELEASED</span> on publication
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="w-full hazard-stripe h-2" aria-hidden="true"></div>
</Layout>

<style>
  .overflow-wrap-anywhere {
    overflow-wrap: anywhere;
    min-width: 0;
  }
</style>
