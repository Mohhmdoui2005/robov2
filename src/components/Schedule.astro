---
// Tournament schedule & bracket timeline
const phases = [
  { phase: 'PHASE 01 // 08:00 - 10:00', title: 'Hardware Scrutineering', body: 'Volumetric box fit check, tare weight measurement, blade edge radius inspection, and magnet downforce verification.', status: 'STATUS: [MANDATORY GATEWAY]', border: 'border-surface-variant', shadow: 'shadow-hard-black', label: 'text-primary-container' },
  { phase: 'PHASE 02 // 10:30 - 14:00', title: 'Round Robin Pools', body: '4 pools per division. Best 2 out of 3 bouts (Yuhkoh points). Top 2 robots from each pool advance to the Ronin Gauntlet.', status: 'STATUS: [SIMULTANEOUS RINGS A/B]', border: 'border-surface-variant', shadow: 'shadow-hard-black', label: 'text-secondary-container' },
  { phase: 'PHASE 03 // 14:30 - 16:30', title: 'The Ronin Gauntlet', body: 'Single elimination bracket. 3-minute pit windows between bouts for battery swaps, tyre cleaning, and calibration adjustments.', status: 'STATUS: [BROADCAST TELEMETRY]', border: 'border-primary-container', shadow: 'shadow-hard-red', label: 'text-primary-container' },
  { phase: 'PHASE 04 // 17:00 - 19:00', title: 'Grand Finals & Honors', body: 'Center ring main event with elevated spectator stands. Valuable prizes and championship honors for the winners, including the Roboko Katana Trophy and IEEE Laurels.', status: 'STATUS: [TROPHY CEREMONY]', border: 'border-secondary-container', shadow: 'shadow-hard-gold', label: 'text-secondary-container' },
];
---
<section class="py-space-2xl bg-surface-container-lowest border-b-2 border-surface-variant" id="schedule">
  <div class="w-full max-w-7xl mx-auto px-margin">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl border-b-2 border-surface-variant pb-space-md">
      <div>
        <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg uppercase text-on-surface mt-space-xs">
          CHAMPIONSHIP SCHEDULE // 日程
        </h2>
      </div>
      <div class="mt-space-sm md:mt-0 font-code-telemetry text-code-telemetry text-secondary-container">OFFICIAL TOURNAMENT STAGES &amp; BOUT CADENCE</div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-space-lg relative">
      {phases.map((p) => (
        <div class={`bg-surface-container border-2 ${p.border} p-space-md ${p.shadow} relative`}>
          <div class={`text-label-badge font-label-badge ${p.label} uppercase mb-1`}>{p.phase}</div>
          <h3 class="text-headline-sm font-headline-sm uppercase text-on-surface font-bold mb-space-sm">{p.title}</h3>
          <p class="text-body-sm font-body-sm text-tertiary mb-space-md">{p.body}</p>
          <div class={`bg-surface-container-lowest border border-surface-variant p-2 text-label-badge font-label-badge ${p.label}`}>
            {p.status}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
