---
// Tournament schedule & bracket timeline
const phases = [
  { phase: 'STAGE 01 // HOMOLOGATION', title: 'Homologation', body: 'Size perimeter check, weight verification, and autonomous failsafe check. Only homologated robots are authorized to compete.', status: 'STATUS: [MANDATORY GATEWAY]', last: false, label: 'text-primary-container' },
  { phase: 'STAGE 02 // FIRST PHASE', title: 'First Phase', body: 'Opening round of the championship. Robots face off in matches earning points to secure a spot for the 2nd phase.', status: 'STATUS: [MATCH POINTS]', last: false, label: 'text-secondary-container' },
  { phase: 'STAGE 03 // GROUP PHASE', title: 'Group Phase', body: 'Teams compete in five balanced groups of three, with the top performers advancing to the final knockout phase.', status: 'STATUS: [5 GROUPS OF 3]', last: false, label: 'text-secondary-container' },
  { phase: 'STAGE 04 // KNOCKOUT BRACKET', title: 'Knockout Bracket', body: 'The 8 qualifying teams enter a single-elimination bracket (quarter-finals, semi-finals, and final) to determine the champion.', status: 'STATUS: [8 TEAMS ELIMINATION]', last: true, label: 'text-primary-container' },
];
---
<section class="py-space-2xl bg-surface-container-lowest border-b-2 border-surface-variant" id="schedule">
  <div class="w-full max-w-7xl mx-auto px-margin">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl border-b-2 border-surface-variant pb-space-md">
      <div>
        <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg uppercase text-on-surface mt-space-xs">
          CHAMPIONSHIP SCHEDULE // 日程
        </h2>
      </div>
      <div class="mt-space-sm md:mt-0 font-code-telemetry text-code-telemetry text-secondary-container">OFFICIAL TOURNAMENT STAGES &amp; BOUT CADENCE</div>
    </div>
    <ol class="relative max-w-3xl ml-2 border-l-2 border-surface-variant pl-space-lg space-y-space-lg">
      {phases.map((p) => (
        <li class="relative">
          <span class={`absolute -left-[1.875rem] top-1 w-3.5 h-3.5 border-2 border-on-surface shadow-hard-black ${p.last ? 'bg-primary-container' : 'bg-surface-container-lowest'}`} aria-hidden="true"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-x-space-md">
            <span class={`text-label-badge font-label-badge uppercase ${p.label}`}>{p.phase}</span>
            <span class="text-label-badge font-label-badge text-tertiary">{p.status}</span>
          </div>
          <h3 class={`text-headline-md font-headline-md uppercase text-on-surface font-bold ${p.last ? 'text-primary-container' : ''} mt-1`}>{p.title}</h3>
          <p class="text-body-md font-body-md text-tertiary mt-space-xs max-w-xl">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
