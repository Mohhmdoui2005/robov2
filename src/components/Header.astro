---
// Top nav bar — full bar at page top, floating pill after scroll
---
<header id="site-header" class="sticky top-0 z-40">
  <div class="nav-shell w-full max-w-7xl mx-auto px-margin flex items-center justify-between h-16 bg-surface-dim border-b-2 border-surface-variant">
    <a class="text-headline-sm font-headline-sm font-bold uppercase tracking-widest text-on-surface flex items-center gap-2 group" href="#">
      <span class="bg-primary-container text-accent-ink px-2 py-1 text-label-stamp font-label-stamp border border-surface-variant">IEEE</span>
      <span class="tracking-tighter normal-case">Roboko</span>
    </a>
    <nav aria-label="Primary Navigation" class="hidden lg:flex items-center text-tertiary font-code-telemetry text-code-telemetry uppercase">
      <span class="nav-link-extra text-secondary-container">
        <a class="hover:text-on-surface transition-none whitespace-nowrap" href="#telemetry">[ Telemetry ]</a>
        <span class="mx-space-sm text-outline" aria-hidden="true">//</span>
      </span>
      <span>
        <a class="hover:text-on-surface transition-none whitespace-nowrap" href="#classification-book">Specs</a>
        <span class="mx-space-sm text-outline" aria-hidden="true">//</span>
      </span>
      <span class="nav-link-extra">
        <a class="hover:text-on-surface transition-none whitespace-nowrap" href="#arena-specs">Arena</a>
        <span class="mx-space-sm text-outline" aria-hidden="true">//</span>
      </span>
      <span>
        <a class="hover:text-on-surface transition-none whitespace-nowrap" href="#bushido-code">Code</a>
        <span class="mx-space-sm text-outline" aria-hidden="true">//</span>
      </span>
      <span>
        <a class="hover:text-on-surface transition-none whitespace-nowrap" href="#schedule">Stages</a>
      </span>
    </nav>
    <div class="flex items-center gap-space-md">
      <a class="nav-cta-secondary hidden lg:inline-flex whitespace-nowrap items-center text-label-stamp font-label-stamp border-2 border-surface-variant px-space-md py-2 text-on-surface hover:border-primary-container hover:text-primary-container shadow-hard-black transition-none btn-brutal" href="/specs">
        RULEBOOK V3-BETA
      </a>
      <a class="inline-flex whitespace-nowrap items-center text-label-stamp font-label-stamp bg-primary-container text-accent-ink border-2 border-on-surface px-space-md py-2 uppercase shadow-hard-black hover:bg-on-primary-container hover:text-accent-ink transition-none btn-brutal" href="https://docs.google.com/forms/d/e/1FAIpQLSdIt04-N2yoR09JSIVkVqnmnrvGI9x5hgCHkITfQ432N1-A_g/viewform?usp=dialog" target="_blank" rel="noopener noreferrer">
        <span class="font-bold sm:mr-1.5">[ 闘 ]</span><span class="hidden sm:inline"> REGISTER SQUAD</span>
      </a>
    </div>
  </div>
  <div class="header-strip h-1 w-full hazard-stripe" aria-hidden="true"></div>
</header>
<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
