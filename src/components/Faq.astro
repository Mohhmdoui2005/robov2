---
// Technical scrutineering FAQ
const faqs = [
  { icon: 'groups', q: 'Is the competition individual or team-based?', a: 'Teams can range from 1 to 4 members. All team members must be registered during the application process.' },
  { icon: 'sports_martial_arts', q: 'How does a match work?', a: 'Matches consist of a short mini-game followed by three rounds. The main goal is to push the opponent out of the ring without causing damage.' },
  { icon: 'memory', q: 'What type of robots are allowed?', a: 'Robots must be 100% autonomous and fit within the weight and dimension limits defined in the rulebook. Remote control and destructive weapons are strictly prohibited.' },
  { icon: 'circle', q: 'What are the rules regarding the ring surface?', a: 'The ring has a matte black surface designed not to reflect light. Robots are strictly forbidden from damaging, scratching, or leaving sticky residue on the ring.' },
];
---
<section class="py-space-lg bg-surface-container-lowest" id="telemetry">
  <div class="w-full max-w-7xl mx-auto px-margin">
    <div class="max-w-2xl mb-space-lg border-b-2 border-surface-variant pb-space-md">
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg uppercase text-on-surface mt-space-xs">
        SCRUTINEERING PROTOCOLS // 審査規約
      </h2>
    </div>
    <div>
      {faqs.map((f) => (
        <div class="grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-x-space-lg gap-y-1 py-space-md border-b border-surface-variant last:border-b-0">
          <h3 class="text-headline-sm font-headline-sm text-secondary-container uppercase flex items-start gap-2 [overflow-wrap:anywhere]">
            <span class="material-symbols-outlined shrink-0">{f.icon}</span>
            {f.q}
          </h3>
          <p class="text-body-sm font-body-sm text-tertiary self-start">{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
