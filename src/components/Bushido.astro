---
// Code of Bushido — tournament regulations
const principles = [
  { kanji: '義', romaji: 'GI // RECTITUDE', title: 'Zero Jamming', body: 'Strictly non-destructive combat. Strobe blinding lights, radio signal jammers, chemical adhesives, and liquids will trigger immediate dishonorable expulsion.', rule: 'RULEBOOK SEC 2.1', accent: 'text-primary-container' },
  { kanji: '勇', romaji: 'YU // COURAGE', title: 'Active Engage', body: 'Robots must actively engage opponents. Stalling, excessive defensive perimeter circling, or passive waiting beyond 10 seconds invokes a referee penalty.', rule: 'RULEBOOK SEC 5.4', accent: 'text-on-surface' },
  { kanji: '礼', romaji: 'REI // RESPECT', title: '5.00s Countdown', body: 'Upon start signal trigger, all movement is frozen until 5.000 seconds elapse. A false start of 4.999s incurs an immediate round forfeit.', rule: 'RULEBOOK SEC 6.2', accent: 'text-on-surface' },
];
---
<section class="py-space-xl bg-surface border-b-2 border-surface-variant" id="bushido-code">
  <div class="w-full max-w-7xl mx-auto px-margin">
    <div class="mb-space-xl border-b-2 border-surface-variant pb-space-md">
      <span class="text-label-badge font-label-badge text-primary-container bg-surface-container-high px-2 py-0.5 border border-primary-container">
        [ 03 // MARTIAL ETHICS &amp; IEEE REGULATIONS ]
      </span>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg uppercase text-on-surface mt-space-xs">THE CODE OF ROBO-KO // 武士道精神</h2>
      <p class="text-body-lg font-body-lg text-tertiary max-w-3xl mt-space-sm">
        Sumo robotics is not merely an exercise in raw wattage; it is an unyielding demonstration of respect for fellow engineers, mechanical honor, and absolute autonomous integrity.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">
      {principles.map((p) => (
        <div class="bg-surface-container-low border-2 border-surface-variant p-space-md flex flex-col justify-between shadow-hard-black hover:border-primary-container transition-none">
          <div>
            <div class={`text-headline-xl font-headline-xl ${p.accent} font-bold leading-none mb-2`}>{p.kanji}</div>
            <div class="text-label-stamp font-label-stamp text-secondary-container font-mono mb-1">{p.romaji}</div>
            <h3 class="text-headline-sm font-headline-sm uppercase text-on-surface font-bold mb-space-sm">{p.title}</h3>
            <p class="text-body-sm font-body-sm text-tertiary">{p.body}</p>
          </div>
          <div class="mt-space-md pt-2 border-t border-surface-variant text-label-badge font-label-badge text-tertiary">
            {p.rule}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
